// wardrobe — data model (brief §23)
// Postgres + Prisma. Deployable to Railway.

generator client {
  provider      = "prisma-client-js"
  // include the Debian (bookworm/openssl 3) engine for the Docker runtime
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemStatus {
  owned
  want
}

enum SourceType {
  manual
  scraped
}

enum LayoutMode {
  free
  grid
  shelves
  columns
  gallery
}

enum SortKey {
  recent
  color
  section
  status
  az
}

model User {
  id              String   @id @default(cuid())
  handle          String   @unique // public, non-secret tag e.g. "moth-7"
  displayName     String?
  // auth: "the combination" (brief §24) — optional, because accounts can also
  // be created passwordless via an email magic code (no combination set).
  combinationHash String? // argon2id hash of the combination
  lookupHash      String?  @unique // separate salted hash for constant-time lookup
  recoveryEmail   String?  @unique // login + recovery email (magic code is sent here)
  recoveryCodeHash      String?   // hash of the short-lived emailed reset code
  recoveryCodeExpiresAt DateTime? // when that emailed code stops working
  recoveryAttempts      Int       @default(0) // wrong emailed-code guesses; locks after a few
  dialPinHash     String? // optional short 2-digit "dial" PIN
  avatar          String?
  defaultTheme    String   @default("daylight")
  displayCurrency String   @default("USD") // stats totals are converted into this
  lastWardrobeId  String? // the wardrobe /studio opens by default
  createdAt       DateTime @default(now())

  passkeys          Passkey[]
  wardrobes         Wardrobe[]
  sessions          Session[]
  challenges        WebAuthnChallenge[]
  notifications     Notification[]
}

// passwordless sign-in / sign-up codes, keyed by email (one active per email).
// Lives independently of User because sign-up happens before a User exists.
model EmailCode {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String // argon2id hash of the 6-digit code
  expiresAt DateTime
  attempts  Int      @default(0) // wrong-code guard
  createdAt DateTime @default(now())
}

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique // base64url
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String? // comma-separated
  deviceLabel  String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// short-lived WebAuthn challenge store (registration / authentication)
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String
  kind      String // "register" | "authenticate"
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // sha256 of the opaque token in the httpOnly cookie (never the raw token)
  expiresAt DateTime
  userAgent String? // shown in the account panel's session list
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wardrobe {
  id         String     @id @default(cuid())
  ownerId    String
  title      String     @default("my wardrobe")
  tagline    String?
  ground     String     @default("daylight")
  pattern    String     @default("none")
  accent     String     @default("cobalt")
  layoutMode LayoutMode @default(free)
  sortKey    SortKey    @default(recent)
  shareCode    String?  @unique
  visibility   String   @default("private") // private | unlisted
  shareDetails Boolean  @default(false) // show item info to guest viewers
  icon       String?    // small glyph shown in the wardrobe switcher
  order      Int        @default(0)
  createdAt  DateTime   @default(now())

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sections Section[]
  items    Item[]
  stickers Sticker[]

  @@index([ownerId])
}

model Section {
  id         String @id @default(cuid())
  wardrobeId String
  name       String
  icon       String?
  color      String?
  order      Int    @default(0)
  shared     Boolean @default(true) // included when the wardrobe is shared
  wardrobe   Wardrobe @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  items      Item[]

  @@index([wardrobeId])
}

model Item {
  id          String     @id @default(cuid())
  wardrobeId  String
  sectionId   String?
  imageUrl    String
  cutoutUrl   String?
  sourceUrl   String?
  name        String
  brand       String?
  price       Float?
  currency    String?    @default("USD")
  status      ItemStatus @default(owned)
  // owned fields
  boughtAt    String? // where bought
  purchasedAt DateTime?
  notes       String?
  // want fields
  targetPrice Float?
  priority    Int?
  // canvas placement
  posX        Float      @default(0)
  posY        Float      @default(0)
  rotation    Float      @default(0)
  sizeTier    String     @default("medium") // hero | large | medium | small
  hue         Int        @default(0) // 0-360 for "arrange by color"
  sourceType  SourceType @default(manual)
  // price tracking (want items with a sourceUrl)
  priceAlert    Boolean   @default(true)
  lowestPrice   Float?
  lastCheckedAt DateTime?
  createdAt   DateTime   @default(now())

  wardrobe Wardrobe @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)
  section  Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  prices   PriceSnapshot[]

  @@index([wardrobeId])
  @@index([sectionId])
  @@index([status, lastCheckedAt])
}

model Sticker {
  id         String   @id @default(cuid())
  wardrobeId String
  kind       String // star | cat | scribble | washi | shrug
  posX       Float    @default(0)
  posY       Float    @default(0)
  rotation   Float    @default(0)
  scale      Float    @default(1)
  wardrobe   Wardrobe @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)

  @@index([wardrobeId])
}

// one observed price for a tracked item (written by the price checker)
model PriceSnapshot {
  id        String   @id @default(cuid())
  itemId    String
  price     Float
  currency  String?
  checkedAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, checkedAt])
}

// in-app notices (price drops, target price hit)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // price_drop | target_hit
  itemId    String?
  body      String
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// fixed-window rate limiter shared by every instance (replaces the old
// in-memory map, which reset on deploy and never expired keys)
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?

  @@index([windowStart])
}
