# --------------------------------------------------------
# wardrobe — environment
# Copy to .env for local dev. In production set these as service variables.
# Required in production: DATABASE_URL, LOOKUP_PEPPER, RP_ID, APP_ORIGIN.
# --------------------------------------------------------

# Postgres connection string.
# Local docker-compose: postgres://wardrobe:wardrobe@localhost:5432/wardrobe
DATABASE_URL="postgres://wardrobe:wardrobe@localhost:5432/wardrobe"

# Secret pepper for account lookup hashes and signed image links.
# Generate once, keep it stable:  openssl rand -base64 48
LOOKUP_PEPPER="change-me"
# Optional separate key for signed guest image URLs (defaults to the pepper).
# SIGNING_SECRET=""

# WebAuthn / passkeys + the CSRF origin check. Must match the site's domain.
RP_ID="localhost"
APP_ORIGIN="http://localhost:3000"

# Email (sign-in codes, recovery, price-drop digests) — Resend.
# Without a key, anything that sends email returns an error.
# MAIL_FROM must be a verified sender/domain in your Resend account.
RESEND_API_KEY=""
MAIL_FROM="wardrobe <onboarding@resend.dev>"

# Image storage — any S3-compatible bucket (Cloudflare R2, Supabase Storage,
# MinIO, AWS S3). Objects must be publicly readable, and the bucket needs a
# CORS rule allowing GET from APP_ORIGIN (for canvas screenshots).
# Without these, uploads fall back to inline images (fine for local dev only).
# Local MinIO from docker-compose:
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="wardrobe"
S3_ACCESS_KEY_ID="wardrobe"
S3_SECRET_ACCESS_KEY="wardrobe-secret"
S3_PUBLIC_URL="http://localhost:9000/wardrobe"
S3_FORCE_PATH_STYLE="true"

# Price tracking: a scheduler calls POST /api/cron/prices with
#   Authorization: Bearer $CRON_SECRET
CRON_SECRET="change-me-too"

# Optional: self-hosted @imgly/background-removal-data (defaults to imgly's CDN)
# NEXT_PUBLIC_IMGLY_PUBLIC_PATH="https://cdn.example.com/imgly/"

NODE_ENV="development"
